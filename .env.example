# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# None of these values are safe to expose to browser JavaScript.

# OpenAI secret key used only on the server to open Realtime sessions.
OPENAI_API_KEY=

# Optional. Defaults to gpt-realtime-2.1, the documented Realtime model.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Supabase project URL, for example https://your-project.supabase.co
SUPABASE_URL=

# Legacy anon key or the newer publishable key. Server-side only in this app.
# Used to refuse a misconfiguration where the public key is copied into the service key.
# The browser does not receive this value. You may also set SUPABASE_PUBLISHABLE_KEY instead.
SUPABASE_ANON_KEY=

# Service-role or secret key. Bypasses Row Level Security. Server-side only.
# You may set SUPABASE_SECRET_KEY instead of SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin. No trailing path. Used as an additional allowed origin.
# Local development stays on http://localhost:3000.
# Production Worker origin: https://demo-assistant.tenjikuweb013.workers.dev
APP_BASE_URL=http://localhost:3000

# Password for reviewing calls, confirming requests, editing clinic settings, and resetting data.
DEMO_ADMIN_PASSWORD=

# Long random string used to sign the admin session cookie. Not a password people type.
SESSION_SECRET=
